# Copy to backend/.env and edit. Every setting in app/core/config.py can be
# overridden here; only the first block is needed for local development.

# --- Required -----------------------------------------------------------------
# Two DIFFERENT random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=changethis_in_production
SESSION_SECRET=changethis_in_production

# Local development only: lets the backend start with the placeholder secrets
# above. Leave false (or remove) in production.
ALLOW_INSECURE_SECRETS=true

# Origin the SPA is served from (used for redirects and email links).
FRONTEND_URL=http://127.0.0.1:3000
# Must be true when FRONTEND_URL is https://.
AUTH_COOKIE_SECURE=false
# lax | strict | none (none requires AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SAMESITE=lax

# --- Optional -----------------------------------------------------------------
# JSON array; wildcards are rejected at startup.
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OAuth login. A provider is only enabled when both its id and secret are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ORCID_CLIENT_ID=
# ORCID_CLIENT_SECRET=

# Email for password reset / verification. Without SMTP_HOST, emails (and their
# links) are written to the backend log instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# SMTP_FROM=

# 256 GiB
# MAX_UPLOAD_BYTES=274877906944
# TRASH_RETENTION_DAYS=30
# RUN_MIGRATIONS_ON_STARTUP=true
# LOG_LEVEL=INFO
